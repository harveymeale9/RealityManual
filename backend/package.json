{
  "name": "reality-manual-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API for The Reality Manual (realitymanual.com) — orders, Stripe payments, shipping calculation.",
  "main": "src/server.js",
  "scripts": {
    "start": "node --no-warnings src/server.js",
