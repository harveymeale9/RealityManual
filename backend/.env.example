# Copy this file to .env and fill in real values.
# Never commit .env — it is gitignored.

# --- Server ---
PORT=4000
NODE_ENV=development

# Comma-separated allowed origins for CORS. While the backend still only
# runs locally (see README's "Phase status"), testing the *live* checkout
# at https://realitymanual.com against a local backend needs that origin
# listed too, not just your local static server's origin.
CORS_ORIGIN=https://realitymanual.com,http://localhost:5500

# --- Database ---
# Path to the SQLite file. Defaults to backend/data/reality-manual.db if unset.
DATABASE_PATH=./data/reality-manual.db

# --- Stripe (TEST MODE keys during development — never live keys here) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- BookVault (fulfillment provider — see CLAUDE.md §26/§64) ---
# No sandbox exists; these hit BookVault's live API even in development.
# Get an API key at https://portal.bookvault.app/apps ("Generate Credentials").
BOOKVAULT_API_KEY=
BOOKVAULT_API_BASE_URL=https://api.bookvault.app/v3
# The 13-digit ISBN BookVault assigned to the uploaded title in their library.
BOOKVAULT_TITLE_ISBN=
