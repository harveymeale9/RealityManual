PANEL_PASSWORD=ormiston
# A second, separate password logging into the SAME main panel
# (ops.realitymanual.com) as a restricted "youtube-reviewer" session,
# instead of the real admin one — used by Google's YouTube API Compliance
# Audit reviewers, who need genuine hands-on access to Content Pipeline/
# Production/Settings (YouTube-relevant fields only; everything else is
# disabled client-side and blocked/redacted server-side — see
# requireAuthOrReviewer and every `req.sessionRole === 'youtube-reviewer'`
# check in server.js). Never reaches Project Manager or TikTok. Empty/
# unset means this login always rejects, matching the "not configured yet"
# pattern used elsewhere in this file.
REVIEWER_PASSWORD=
ALLOWED_ORIGINS=https://realitymanual.com,https://www.realitymanual.com
PORT=4001
DATA_DIR=/data

# Customer mailbox (info@realitymanual.com). The mailbox UI and durable
# local draft/message store run without credentials. Once the actual host is
# known, its IMAP/API receiver and SMTP/API sender are injected server-side;
# credentials must remain in the VPS .env and are never returned to the UI.
MAILBOX_ADDRESS=info@realitymanual.com
MAILBOX_DISPLAY_NAME=Reality Manual Support
MAILBOX_APP_PASSWORD=
MAILBOX_IMAP_HOST=mail.privateemail.com
MAILBOX_IMAP_PORT=993
MAILBOX_IMAP_SECURE=true
MAILBOX_SMTP_HOST=mail.privateemail.com
MAILBOX_SMTP_PORT=465
MAILBOX_SMTP_SECURE=true
# On the first connection import at most the newest 250 messages; every new
# message after that is synced incrementally by stable IMAP UID.
MAILBOX_INITIAL_SYNC_LIMIT=250
# Automatically digest every inbound message with a tool-free classifier,
# archive it after successful triage, and alert Project Manager only when
# Harvey needs to know about it.
MAIL_TRIAGE_ENABLED=true

# Automated performance email. The default schedule is every Monday at
# 09:00 Europe/London and the completed Monday-to-Monday period is sent once;
# a durable report-run row prevents duplicates after restarts/redeploys.
WEEKLY_REPORT_ENABLED=true
WEEKLY_REPORT_RECIPIENT=harveymeale9@gmail.com
WEEKLY_REPORT_TIME_ZONE=Europe/London
WEEKLY_REPORT_HOUR=9
# VPS disk monitoring. Checked hourly; one email is sent when usage first
# crosses warning and one more if it escalates to critical. It stays silent
# while usage remains in the same band and rearms after returning below 80%.
DISK_MONITOR_ENABLED=true
DISK_ALERT_RECIPIENT=harveymeale9@gmail.com
DISK_ALERT_WARNING_PERCENT=80
DISK_ALERT_CRITICAL_PERCENT=90

# Durable wait-and-continue watchers. Polling itself is deterministic and does
# not consume agent allowance; a satisfied condition wakes its selected agent
# only if that provider's weekly allowance has at least the request's reserve
# remaining (15% by default in register-monitor.js).
BACKGROUND_MONITORS_ENABLED=true
BACKGROUND_MONITOR_INTERVAL_MS=30000
BACKGROUND_MONITOR_REQUEST_DIR=/data/monitor-requests
# Read-only bind mount added by deploy.sh; no storefront credential or public
# revenue endpoint is needed by the weekly reporter.
STOREFRONT_DB_PATH=/store-data/reality-manual.db

# Voice app. ElevenLabs remains the speech-to-text provider for microphone
# uploads and the TTS provider for Claude. Codex TTS uses the separate OpenAI
# Audio API credential below; this does not authenticate the Codex agent.
# CLAUDE_REPO_DIR must match
# wherever the repo is bind-mounted inside the container (see the `docker run`
# command in CLAUDE.md section 74 / 65's style) — /repo, not the host path.
# CLAUDE_CODE_OAUTH_TOKEN comes from running `claude setup-token` on the VPS
# host directly (never generate/capture it through an automated command —
# it's a long-lived credential). Container runs as the non-root "node" user
# specifically so bypass-permissions mode is actually usable (it's refused
# outright for root/EUID 0).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
VOICE_TTS_PROVIDER_CLAUDE=elevenlabs
VOICE_TTS_PROVIDER_CODEX=openai
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=cedar
CLAUDE_BIN=claude
CLAUDE_REPO_DIR=/repo
CLAUDE_CODE_OAUTH_TOKEN=

# Codex runs on the VPS host through the container's existing SSH key rather
# than inside this image. The host CLI reuses its own saved ChatGPT/Codex
# authentication and persistent thread store; no Codex credential is copied
# into this env file or container.
CODEX_HOST=ubuntu@host.docker.internal
CODEX_HOST_BIN=/root/.local/bin/codex
CODEX_HOST_REPO=/srv/realitymanual-repo
CODEX_HOST_DATA_DIR=/root/ops-service-data
# Durable run journals: these are the same bind-mounted directory as seen
# inside the container and by host-native Codex, respectively.
CODEX_RUN_DIR=/data/codex-runs
CODEX_HOST_RUN_DIR=/root/ops-service-data/codex-runs

# Claude Project Manager voice turns also now run on the VPS host over SSH
# (as the non-root `ubuntu` user, not root — --allow-dangerously-skip-
# permissions is refused outright under EUID 0), one process per turn, for
# the same restart-survival reason as Codex above (CLAUDE.md's Claude host
# recovery section). CLAUDE_HOST_HOME must NOT be `ubuntu`'s own real
# $HOME — that's Harvey's personal interactive Claude Code identity on the
# VPS. It's a dedicated directory whose .claude/.claude.json are symlinks
# onto the same files already bind-mounted into the container (see
# deploy.sh), set up once directly on the host, not by this repo. Uses the
# CLAUDE_CODE_OAUTH_TOKEN above (passed through the ssh command's
# environment), not a separately saved credential.
CLAUDE_HOST=ubuntu@host.docker.internal
CLAUDE_HOST_BIN=/usr/bin/claude
CLAUDE_HOST_REPO=/repo
CLAUDE_HOST_HOME=/root/ops-service-claude-home/host-identity
CLAUDE_RUN_DIR=/data/claude-runs
CLAUDE_HOST_RUN_DIR=/root/ops-service-data/claude-runs

# YouTube (Google) OAuth for publishing to a connected channel — see
# src/youtubeAuth.js and CLAUDE.md's YouTube API review section. Created
# in Google Cloud Console under "APIs & Services > Credentials" as an
# OAuth 2.0 Client ID (Web application type). Redirect URI must exactly
# match what's registered there, e.g.
# https://ops.realitymanual.com/api/youtube/oauth/callback
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=https://ops.realitymanual.com/api/youtube/oauth/callback
# Once per 24 hours (with an hourly due-check), reconcile YouTube-backed
# Posted / Live cards against their real visibility. API failures never move
# cards; set false only to disable the automatic audit entirely.
YOUTUBE_PUBLICATION_AUDIT_ENABLED=true

# TikTok Login Kit + Content Posting API for publishing to a connected
# account — see src/tiktokAuth.js. Client key/secret come from a TikTok
# developer app's Sandbox (developers.tiktok.com), used until the app
# passes full review. Redirect URI must exactly match what's registered
# there.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://ops.realitymanual.com/api/tiktok/oauth/callback
