{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "rm-storefront-api-staging",
  "main": "src/index.js",
  "compatibility_date": "2026-11-14",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rm-storefront-staging",
      "database_id": "cfc8318c-2be0-49ab-89f6-27ea8360fc0f"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "reality-manual-media"
    }
  ]
}
