{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "rm-storefront-api-staging",
  "main": "src/index.js",
  "compatibility_date": "2026-11-14",
  "workers_dev": true,
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "CORS_ORIGIN": "https://realitymanual.com,https://ops.realitymanual.com",
    "STRIPE_PUBLISHABLE_KEY": "pk_live_51TYNf5R2O5kp0xhWex3Q5UOtulEZfqMTrNqehGCKy0frmWaSDoyTJlpStmxnxShHSvm8o7t4GfrqsM1TjD7QmEsG00r7RXTHWS",
    "BOOKVAULT_TITLE_ISBN": "9658364000016",
    "RESEND_FROM_EMAIL": "The Reality Manual <orders@realitymanual.com>",
    "RESEND_REPLY_TO": "info@realitymanual.com",
    "REPORTS_ENABLED": "false",
    "REPORT_ALLOWED_IPS": "187.124.146.235,2a02:4780:4:12d1::1"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rm-storefront-staging",
      "database_id": "cfc8318c-2be0-49ab-89f6-27ea8360fc0f"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "reality-manual-media"
    }
  ]
}
